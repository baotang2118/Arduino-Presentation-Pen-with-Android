# Auto detect text files and perform LF normalization

* text=auto

# Report Arduino sketches as C++ instead of the default "Arduino" language
*.ino linguist-language=C++

# The Gradle wrapper scripts require fixed line endings to stay executable
gradlew text eol=lf
gradlew.bat text eol=crlf

# Photos and screenshots are stored in Git LFS
screenshot-result/*.png filter=lfs diff=lfs merge=lfs -text
screenshot-result/*.jpg filter=lfs diff=lfs merge=lfs -text

